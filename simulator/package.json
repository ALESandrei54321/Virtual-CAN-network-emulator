{
  "name": "virtual-can-simulator",
  "version": "1.0.0",
  "description": "Modular vehicle network simulator with bit-level bus emulation and RP2040 MCU simulation",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
